{
  "name": "thoth",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p . && tsc -p packages/web",
    "test": "node scripts/test.ts",
    "load": "node --test --test-concurrency=1 \"packages/*/test/**/*.collab.ts\"",
    "acceptance": "node --test --test-concurrency=1 --test-force-exit \"packages/server/test/acceptance/*.acceptance.ts\"",
    "build": "npm run build -w @thoth/web",
    "ci": "node scripts/ci.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@modelcontextprotocol/inspector": false
  }
}
