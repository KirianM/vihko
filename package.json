{
  "name": "vihko",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p . && tsc -p packages/web",
    "test": "node scripts/test.ts",
    "load": "node scripts/seeded.ts node --test --test-concurrency=1 \"packages/*/test/**/*.collab.ts\"",
    "acceptance": "node scripts/seeded.ts node --test --test-concurrency=1 --test-force-exit \"packages/server/test/acceptance/*.acceptance.ts\"",
    "build": "npm run build -w @vihko/web",
    "ci": "node scripts/ci.ts",
    "upgrade-smoke": "node scripts/upgrade-smoke.ts",
    "screenshots": "npm run build && node --no-experimental-webstorage scripts/screenshots.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@modelcontextprotocol/inspector": false,
    "fsevents": false
  }
}
