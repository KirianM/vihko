{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/core/src",
    "packages/core/test",
    "packages/server/src",
    "packages/server/test",
    "packages/web/test",
    "packages/web/e2e",
    "packages/web/playwright.config.ts"
  ]
}
